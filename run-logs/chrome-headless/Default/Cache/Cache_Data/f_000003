export function normalizeRole(rawRole) {
  if (!rawRole) {
    return 'admin';
  }

  const role = String(rawRole).trim().toLowerCase();

  if (role === 'ceo' || role === 'superadmin' || role === 'admin') {
    return 'admin';
  }

  if (role === 'accountant') {
    return 'accountant';
  }

  if (role === 'receptionist') {
    return 'receptionist';
  }

  if (role === 'dentist') {
    return 'dentist';
  }

  return 'admin';
}

